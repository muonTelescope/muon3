# OS and editors
.DS_Store
**/.DS_Store

# Credentials (never commit)
.rclone.conf

# Python
.venv/
*.pyc
**/__pycache__/

# Node / Bun (manifests and bun.lock are tracked; installed packages are not)
node_modules/
/dist/

# Generated data. *.json is ignored repo-wide; source JSON is force-added or re-included by a nested .gitignore (hw/)
*.json
*.log
*.root
*.out
*.tar.gz
*.tgz

# Compiled code (firmware, gateware, C++)
*.bin
*.d
*.elf
*.o
**/.build/
**/build*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# LaTeX leftovers
*.asc
*.aux
*.bbl
*.blg
*.fls
*.toc

# CAD intermediates (STEP and the FreeCAD documents under hw/out are regenerated)
**/*.FCBak
cad/sphenix_hcal/step/*.FCStd
cad/sphenix_hcal/stl/

# Geant4 data and runs
geant4-data/
sim/geant4/*.csv
sim/geant4/build*/
sim/geant4/testbuild/
sim/geant4/plots/
